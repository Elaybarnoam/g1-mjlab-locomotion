{
  "schema_version": 2,
  "implementation": "rsl-rl-lib==5.5.0",
  "algorithm": "PPO",
  "actor_hidden_dims": [512, 256, 128],
  "critic_hidden_dims": [512, 256, 128],
  "activation": "elu",
  "actor_observation_normalization": true,
  "critic_observation_normalization": true,
  "initial_action_std": 0.2,
  "actor_mean_output_gain": 0.01,
  "actor_mean_output_bias": 0.0,
  "gamma": 0.99,
  "gae_lambda": 0.95,
  "clip_parameter": 0.2,
  "value_loss_coefficient": 1.0,
  "clipped_value_loss": true,
  "entropy_coefficient": 0.005,
  "learning_rate": 0.0003,
  "learning_rate_schedule": "adaptive",
  "desired_kl": 0.01,
  "maximum_gradient_norm": 1.0,
  "optimizer": "adam",
  "epochs": 5,
  "minibatches": 4,
  "rollout_steps": 24,
  "recurrent": false,
  "mixed_precision": false
}
